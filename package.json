{
  "name": "min-sheep-ui",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "homepage":"https://min-sheep-ui.vercel.app/",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.ts,.tsx,.vue",
    "format": "prettier --write src/ && prettier --write packages/ && prettier --write docs/ &&  prettier --write cli/",
    "prepare": "husky install",
    "docs:dev": "vitepress dev docs --host",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "docs:ssr": "vitepress build --ssr",
    "docs:all": "npm run docs:build && npm run docs:ssr",
    "build:lib": "node ./scripts/build.js",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "cli": "cd cli && npm run cli",
    "document": "serve -d document"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@floating-ui/dom": "^1.7.4",
    "@fortawesome/fontawesome-svg-core": "^7.0.1",
    "@fortawesome/free-solid-svg-icons": "^7.0.1",
    "@fortawesome/vue-fontawesome": "^3.1.2",
    "@icon-park/svg": "^1.4.2",
    "@min-sheep-ui/hooks": "workspace:*",
    "@min-sheep-ui/utils": "workspace:*",
    "classnames": "^2.5.1",
    "codemirror-minimap": "^1.0.6",
    "dayjs": "^1.11.13",
    "element-plus": "^2.9.3",
    "highlight.js": "^11.11.1",
    "monaco-editor": "^0.53.0",
    "monaco-editor-vue3": "^0.1.10",
    "monaco-themes": "^0.4.7",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/vue": "^8.1.0",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^5.7.0",
    "@typescript-eslint/parser": "^5.7.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitejs/plugin-vue-jsx": "4.1.1",
    "@vitest/coverage-v8": "2.1.8",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.26.0",
    "fs-extra": "^11.2.0",
    "happy-dom": "^16.3.0",
    "husky": "^9.1.7",
    "inquirer": "^8.2.7",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "sass": "^1.93.2",
    "serve": "^14.2.4",
    "tailwindcss": "3.4.17",
    "typescript": "^5.7.2",
    "vite": "6.0.7",
    "vite-plugin-dts": "^4.4.0",
    "vitepress": "^1.6.4",
    "vitepress-theme-demoblock": "^3.1.3",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue}": "eslint --cache --fix"
  }
}