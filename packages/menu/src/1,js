// 菜单上下文类型
export interface MenuContext {
  mode: MenuMode;
  router: boolean;
  activeKey: string;
  expandedKeys: string[];
  selectedKeys: string[];
  accordion: boolean;
  inlineIndent: number;
  triggerSubMenuAction: 'hover' | 'click';
  showIcon: boolean;
  handleItemClick: (option: MenuOption) => void;
  handleSubMenuExpand: (key: string, expanded: boolean) => void;
  registerMenuItem: (key: string, element: any) => void;
  unregisterMenuItem: (key: string) => void;
  registerSubMenu: (key: string, element: any) => void;
  unregisterSubMenu: (key: string) => void;
}

// 菜单项注册信息
export interface MenuItemRegister {
  key: string;
  element: HTMLElement;
  option: MenuOption;
}

// 子菜单注册信息
export interface SubMenuRegister {
  key: string;
  element: HTMLElement;
  option: MenuOption;
}

// 菜单事件类型
export interface MenuEvents {
  onItemClick: (option: MenuOption) => void;
  onSubMenuExpand: (keys: string[]) => void;
  onSelectChange: (keys: string[]) => void;
  onActiveChange: (key: string) => void;
}

// 菜单暴露的方法
export interface MenuExpose {
  updateActiveKey: (key: string) => void;
  updateExpandedKeys: (keys: string[]) => void;
  updateSelectedKeys: (keys: string[]) => void;
  getMenuItems: () => MenuItemRegister[];
  getSubMenus: () => SubMenuRegister[];
  getMenuItemByKey: (key: string) => MenuItemRegister | undefined;
  getSubMenuByKey: (key: string) => SubMenuRegister | undefined;
}

// 菜单项暴露的方法
export interface MenuItemExpose {
  getElement: () => HTMLElement;
  getOption: () => MenuOption;
  setActive: (active: boolean) => void;
  setSelected: (selected: boolean) => void;
}

// 子菜单暴露的方法
export interface SubMenuExpose {
  getElement: () => HTMLElement;
  getOption: () => MenuOption;
  setExpanded: (expanded: boolean) => void;
  getExpanded: () => boolean;
}

// 菜单分组暴露的方法
export interface MenuItemGroupExpose {
  getElement: () => HTMLElement;
  getTitle: () => string;
  setDisabled: (disabled: boolean) => void;
}

// 菜单主题类型
export type MenuTheme = 'light' | 'dark';

// 菜单尺寸类型
export type MenuSize = 'large' | 'default' | 'small';

// 导出所有类型
export type { VNode };

// 默认导出菜单配置类型
export default MenuOption; 