写一个menu支持 option传入展示菜单，支持默认插槽展示菜单，菜单支持分组，还有 sub-menu， 
import { VNode, PropType } from 'vue';

// 菜单模式类型
export type MenuMode = 'horizontal' | 'vertical' | 'pop';
// pop是右边弹出，部署从下边

// 菜单项配置接口
export interface MenuOption {
  // 菜单项类型，'group' 表示分组
  type?: string;
  // 菜单项显示文本，可以是字符串或渲染函数
  label: string | (() => VNode | string);
  // 图标类名
  icon?: string;
  // 是否禁用
  disabled?: boolean;
  // 是否显示（用于动态控制显示/隐藏）
  show?: boolean;
  // 子菜单项
  children?: MenuOption[];
  // 唯一标识
  key: string;
  // 路由配置（在路由模式下使用）
  route?: any;
  // 其他任意属性
  [key: string]: any;
}

// 手动定义 Props 类型，避免使用 ExtractPropTypes
export interface MenuProps {
  option?: MenuOption[];
  mode?: MenuMode;
  router?: boolean;
  defaultActive?: string;
  accordion?: boolean;
  expandedKeys?: string[];
  selectedKeys?: string[];
  menuClass?: string;
  showIcon?: boolean;
  inlineIndent?: number;
  triggerSubMenuAction?: 'hover' | 'click';
  closeOnClick?: boolean;
  popupClassName?: string;
  popupStyle?: Record<string, any>;
}

// 菜单项 Props 类型
export interface MenuItemProps {
  path?: string;
  icon?: string;
  title?: string;
  popperClass?: string;
  disabled?: boolean;
  route?: any;
  option: MenuOption;
  active?: boolean;
  selected?: boolean;
  customClass?: string;
  onClick?: (option: MenuOption) => void;
  onMouseenter?: (option: MenuOption) => void;
  onMouseleave?: (option: MenuOption) => void;
}

// 菜单分组 Props 类型
export interface MenuItemGroupProps {
  title?: string;
  disabled?: boolean;
  customClass?: string;
  mode?: 'vertical' | 'horizontal';
}

// 子菜单 Props 类型
export interface SubMenuProps {
  option: MenuOption;
  active?: boolean;
  mode?: MenuMode;
  popperClass?: string;
  disabled?: boolean;
  expanded?: boolean;
  popupStyle?: Record<string, any>;
  onExpandChange?: (expanded: boolean, option: MenuOption) => void;
  onTitleClick?: (option: MenuOption) => void;
}

// 为了兼容性，保留原来的 props 定义（但不用于类型提取）
export const menuProps = {
  option: {
    type: Array as PropType<MenuOption[]>,
    default: (): MenuOption[] => []
  },
  mode: {
    type: String as PropType<MenuMode>,
    default: 'vertical' as MenuMode,
    validator: (value: string): boolean =>
      ['horizontal', 'vertical', 'pop'].includes(value),
  },
  router: {
    type: Boolean,
    default: false,
  },
  defaultActive: {
    type: String,
    default: '',
  },
